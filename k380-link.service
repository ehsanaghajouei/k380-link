[Unit]
Description=K380 Bluetooth link keeper (sniff off, health log, reconnect)
After=bluetooth.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/sbin/k380-link -a XX:XX:XX:XX:XX:XX -A YY:YY:YY:YY:YY:YY -w 3 -t 3
Restart=always
RestartSec=2
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_BLUETOOTH AF_UNIX

[Install]
WantedBy=multi-user.target
